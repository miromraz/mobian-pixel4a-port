diff --git a/hexagonrpcd/sns_registry.c b/hexagonrpcd/sns_registry.c
new file mode 100644
index 0000000..f01351b
--- /dev/null
+++ b/hexagonrpcd/sns_registry.c
@@ -0,0 +1,121 @@
+/*
+ * sns_registry reverse interface (DSP -> apps)
+ *
+ * The Pixel 4a (sunfish) SLPI sensor firmware opens an apps-side "sns_registry"
+ * local interface via apps_remotectl while bringing up its sensor registry.
+ * When the interface is absent the CHRE sensor_process asserts (sar.cc:27) and
+ * the whole ADSP crash-loops.
+ *
+ * SNS_REG is documented (for the older MSM8996 SSC) as a QMI service where the
+ * SSC requests platform sensor data "in groups of keys" and the AP responds
+ * (see gitlab.com/lucaweiss/sns-reg). The newer SLPI here uses the same concept
+ * over a FastRPC reverse interface instead of QMI; there is no public reference
+ * for the FastRPC variant, so the method ABIs are being reverse-engineered from
+ * the firmware's live invocations. This handler logs each call's input buffers
+ * and returns a benign zeroed response so we can learn the protocol.
+ *
+ * Copyright (C) 2026 The Sensor Shell Contributors
+ *
+ * This file is part of sensh.
+ *
+ * Sensh is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include <ctype.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libhexagonrpc/interface.h>
+
+#include "listener.h"
+#include "sns_registry.h"
+
+static void log_buf(const char *tag, const struct fastrpc_io_buffer *b)
+{
+	const unsigned char *p = b->p;
+	uint32_t i;
+
+	fprintf(stderr, "  %s s=%u hex=", tag, b->s);
+	for (i = 0; i < b->s && i < 48; i++)
+		fprintf(stderr, "%02x", p[i]);
+	fprintf(stderr, " str='");
+	for (i = 0; i < b->s && i < 48; i++)
+		fputc(isprint(p[i]) ? p[i] : '.', stderr);
+	fprintf(stderr, "'\n");
+}
+
+/*
+ * Method 0, observed sc = 0x00020100 (INBUFS=2, OUTBUFS=1). The primary input
+ * buffer is 8 bytes (2 words), so in_nums + in_bufs + out_bufs = 2. With one
+ * input buffer (the requested key-group) and one output buffer (the returned
+ * data) this is a read shape, mirroring apps_std_fread's (1,0,2,1) layout:
+ * in_nums=0, in_bufs=1, out_nums=0, out_bufs=1. The primary input then carries
+ * [in_buf_size][out_buf_size]. Logs the request and returns a zeroed output so
+ * we can see how the firmware reacts and what it asks for next.
+ */
+static const struct fastrpc_function_def_interp2 sns_registry_m0_def = {
+	.msg_id = 0,
+	.in_nums = 0,
+	.in_bufs = 1,
+	.out_nums = 0,
+	.out_bufs = 1,
+};
+
+static uint32_t sns_registry_m0(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	fprintf(stderr, "sns_registry method 0:\n");
+	log_buf("in[0]", &inbufs[0]);
+	log_buf("in[1]", &inbufs[1]);
+
+	if (outbufs != NULL && outbufs[0].p != NULL) {
+		fprintf(stderr, "  out[0] cap=%u\n", outbufs[0].s);
+		memset(outbufs[0].p, 0, outbufs[0].s);
+	}
+
+	return 0;
+}
+
+static const struct fastrpc_function_impl sns_registry_procs[] = {
+	{ .def = &sns_registry_m0_def, .impl = sns_registry_m0, },
+};
+
+static const struct fastrpc_interface sns_registry_template = {
+	.name = "sns_registry",
+	.data = NULL,
+	.n_procs = 1,
+	.procs = sns_registry_procs,
+};
+
+struct fastrpc_interface *fastrpc_sns_registry_init(void)
+{
+	struct fastrpc_interface *iface;
+
+	iface = malloc(sizeof(struct fastrpc_interface));
+	if (iface == NULL)
+		return NULL;
+
+	memcpy(iface, &sns_registry_template, sizeof(struct fastrpc_interface));
+
+	return iface;
+}
+
+void fastrpc_sns_registry_deinit(struct fastrpc_interface *iface)
+{
+	free(iface);
+}
