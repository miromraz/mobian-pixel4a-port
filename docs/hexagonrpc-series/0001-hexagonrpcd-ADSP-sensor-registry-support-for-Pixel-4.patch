+static int test_mapped_write_create(void)
+{
+	struct hexagonfs_fd *fds[HEXAGONFS_MAX_FD] = { 0 };
+	struct hexagonfs_fd dir = {
+		.is_assigned = true,
+		.up = NULL,
+		.ops = &hexagonfs_mapped_ops,
+	};
+	struct hexagonfs_fd *file;
+	char tmpdir[] = "/tmp/hexagonfs-write-XXXXXX";
+	const char expected[] = "registry write\n";
+	char path[sizeof(tmpdir) + sizeof("/created")];
+	char buf[sizeof(expected)];
+	ssize_t written;
+	int ret;
+	int fd;
+
+	if (mkdtemp(tmpdir) == NULL)
+		return 1;
+
+	ret = hexagonfs_mapped_ops.from_dirent(tmpdir, true, &dir.data);
+	if (ret)
+		return 1;
+
+	hexagonfs_leaf_open_flags = O_RDWR | O_CREAT | O_TRUNC;
+	ret = hexagonfs_mapped_ops.openat(&dir, "created", false, &file);
+	hexagonfs_leaf_open_flags = 0;
+	if (ret)
+		return 1;
+
+	fds[0] = file;
+	written = hexagonfs_write(fds, 0, strlen(expected), expected);
+	if (written != strlen(expected))
+		return 1;
+
+	hexagonfs_mapped_ops.close(file->data);
+	free(file);
+	hexagonfs_mapped_ops.close(dir.data);
+
+	snprintf(path, sizeof(path), "%s/created", tmpdir);
+	fd = open(path, O_RDONLY);
+	if (fd == -1)
+		return 1;
+
+	memset(buf, 0, sizeof(buf));
+	ret = read(fd, buf, sizeof(buf));
+	close(fd);
+	unlink(path);
+	rmdir(tmpdir);
+
+	if (ret != strlen(expected))
+		return 1;
+
+	return memcmp(buf, expected, strlen(expected));
+}
+
 int main(int argc, const char **argv)
 {
 	int ret;
@@ -94,5 +153,9 @@ int main(int argc, const char **argv)
 	if (ret)
 		return ret;
 
+	ret = test_mapped_write_create();
+	if (ret)
+		return ret;
+
 	return 0;
 }
