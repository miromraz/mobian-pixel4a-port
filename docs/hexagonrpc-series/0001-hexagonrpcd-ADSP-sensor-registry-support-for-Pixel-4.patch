diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index bd9f353..94463ea 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -29,6 +29,8 @@
 
 #include "hexagonfs.h"
 
+int hexagonfs_leaf_open_flags = 0;
+
 static char *copy_segment_and_advance(const char *path,
 				      bool *trailing_slash,
 				      const char **next)
@@ -244,6 +246,78 @@ ssize_t hexagonfs_read(struct hexagonfs_fd **fds, int fileno, size_t size, void
 	return fd->ops->read(fd, size, ptr);
 }
 
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->write == NULL)
+		return -ENOSYS;
+
+	return fd->ops->write(fd, size, ptr);
+}
+
+/*
+ * sunfish: create a directory in the underlying real filesystem so the ADSP
+ * sensor firmware can build its registry working dirs. Resolves the parent of
+ * `name` to a mapped (real) directory, then delegates to its mkdir op for the
+ * basename. Only directories backed by a real fs (hexagonfs_mapped_ops) can be
+ * created in; virtual dirs return -ENOSYS.
+ */
+int hexagonfs_mkdir(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name, mode_t mode)
+{
+	char *parent, *base;
+	const char *slash;
+	int pfd, ret;
+
+	slash = strrchr(name, '/');
+	if (slash == NULL) {
+		parent = strdup(".");
+		base = strdup(name);
+	} else if (slash == name) {
+		parent = strdup("/");
+		base = strdup(slash + 1);
+	} else {
+		parent = strndup(name, slash - name);
+		base = strdup(slash + 1);
+	}
+
+	if (parent == NULL || base == NULL) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	/* reject trailing-slash paths (no basename to create) */
+	if (*base == '\0') {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	pfd = hexagonfs_openat(fds, rootfd, dirfd, parent);
+	if (pfd < 0) {
+		ret = pfd;
+		goto out;
+	}
+
+	if (fds[pfd]->ops->mkdir == NULL)
+		ret = -ENOSYS;
+	else
+		ret = fds[pfd]->ops->mkdir(fds[pfd], base, mode);
+
+	hexagonfs_close(fds, pfd);
+
+out:
+	free(parent);
+	free(base);
+	return ret;
+}
+
 int hexagonfs_readdir(struct hexagonfs_fd **fds, int fileno, size_t ent_size, char *ent)
 {
 	struct hexagonfs_fd *fd;
