+/*
+ * sunfish: the ADSP sensor firmware creates registry working directories while
+ * rebuilding its sensor registry. Without this the call returns "unsupported"
+ * and the CHRE sensor_process asserts (sar.cc:27), crashing the whole ADSP.
+ * The method passes no mode (in_nums=0); inbufs[1] is the (NUL-terminated) path.
+ */
+static uint32_t apps_std_mkdir(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *name = inbufs[1].p;
+	int ret;
+
+	// The name must be NULL-terminated
+	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_mkdir(ctx->fds, ctx->rootfd, ctx->rootfd, name, 0755);
+	if (ret) {
+		fprintf(stderr, "Could not mkdir %s: %s\n",
+				name, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("mkdir(%s)\n", name);
+#endif
+
+	return 0;
+}
