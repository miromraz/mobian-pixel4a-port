+static ssize_t mapped_write(struct hexagonfs_fd *fd, size_t size, const void *in)
+{
+	struct mapped_ctx *ctx = fd->data;
+	ssize_t ret;
+
+	ret = write(ctx->fd, in, size);
+	if (ret < 0)
+		return -errno;
+
+	return ret;
+}
+
+static int mapped_mkdir(struct hexagonfs_fd *dir, const char *segment, mode_t mode)
+{
+	struct mapped_ctx *ctx = dir->data;
+
+	if (mkdirat(ctx->fd, segment, mode) == -1) {
+		/* an already-present registry dir is fine */
+		if (errno == EEXIST)
+			return 0;
+		return -errno;
+	}
