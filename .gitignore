# Build artifacts and proprietary/device blobs — never commit (reproducible or extracted from device)
*.simg
*.img
*.mbn
*.ko
*.fw
*.bin
*.tlv
*.b[0-9]*
*.gz
*.zip
*.tar
work/*.simg
work/output/
recipe/output/
# personal SSH pubkey baked into the dev image — not a repo artifact
ssh-authorized-keys
# WCN3990 daemons built on-device (tqftpserv, pd-mapper)
work/wcn/bin/
# extracted vendor firmware: get it from sm7150-mainline/firmware-google-sunfish
# (or your own device) - never commit it here. *.bin already covers the tuning
# blobs; these two were the gaps that let firmware in.
*.wmfw
*.jsn
# Built kernel/hexagonrpcd outputs — you build these yourself and drop them into
# the overlay; they are stale within a couple of weeks and not committed here.
# See README.md "Kernel source" and the "build the kernel" install step.
vmlinuz*
*.dtb
modules.*
work/hexagonrpc/bin/
work/hexagonrpc/lib/

# Local libcamera/plasma-camera source trees used to generate the patches above.
work/tools/camera/build/
