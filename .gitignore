# Build artifacts and proprietary/device blobs — never commit (reproducible or extracted from device)
*.simg
*.img
*.mbn
*.ko
*.fw
*.bin
*.tlv
*.b[0-9]*
*.gz
*.zip
*.tar
work/*.simg
work/output/
recipe/output/
# personal SSH pubkey baked into the dev image — not a repo artifact
ssh-authorized-keys
# WCN3990 daemons built on-device (tqftpserv, pd-mapper)
work/wcn/bin/
# extracted vendor firmware: get it from sm7150-mainline/firmware-google-sunfish
# (or your own device) - never commit it here. *.bin already covers the tuning
# blobs; these two were the gaps that let firmware in.
*.wmfw
*.jsn
