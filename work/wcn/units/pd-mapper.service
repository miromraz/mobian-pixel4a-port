[Unit]
Description=Qualcomm PD mapper
After=qrtr-ns.service
Wants=qrtr-ns.service
Before=rmtfs.service
[Service]
ExecStartPre=/bin/sh -c "echo -n /lib/firmware/qcom/sm7150/google/sunfish > /sys/module/firmware_class/parameters/path"
ExecStart=/usr/local/bin/pd-mapper
Restart=on-failure
RestartSec=1
[Install]
WantedBy=multi-user.target
