+void Worker::reconfigure(const bool forStillCapture)
+{
+    if (!m_camera || m_stillConfig == forStillCapture) {
+        return;
+    }
+
+    // stopViewFinder() releases the camera and drops our reference, so keep one
+    const std::shared_ptr<libcamera::Camera> camera = m_camera;
+
+    stopViewFinder();
+
+    m_stillConfig = forStillCapture;
+    m_camera = camera;
+
+    if (const int ret = m_camera->acquire(); ret < 0) {
+        setError(ret);
+        return;
+    }
+
+    startViewFinder();
+}
