+/*
+ * \brief Correct defective (hot/dead) pixels in one raw Bayer line, in place
+ * \param[in] line Pointer to the first visible pixel of the (writable) line
+ *
+ * Each pixel is compared against its two same-colour horizontal neighbours
+ * (2 pixels away, so same Bayer colour). A pixel is clamped to the neighbour
+ * range only when it deviates from both neighbours by more than the tuned
+ * threshold, leaving ordinary detail and edges untouched. Runs entirely in
+ * the 8-bit domain the CPU debayer already uses (high byte of each pixel),
+ * and is only invoked for CSI-2 packed inputs (dpcSupported_).
+ */
+void DebayerCpuThread::dpcLine(uint8_t *line)
+{
+	const unsigned int bpp = debayer_->inputConfig_.bpp;
+	const unsigned int ppg = debayer_->inputConfig_.patternSize.width;
+	const unsigned int bpg = ppg * bpp / 8; /* bytes per pixel group, incl. LSB tail */
+	const unsigned int numPixels = debayer_->window_.width;
+	const int thr = static_cast<int>(debayer_->dpcThreshold_);
+
+	/* Byte offset of pixel i, skipping the packed group's LSB tail byte(s). */
+	auto off = [ppg, bpg](unsigned int i) { return (i / ppg) * bpg + (i % ppg); };
+
+	for (unsigned int i = 2; i + 2 < numPixels; i++) {
+		uint8_t *p = &line[off(i)];
+		const int a = line[off(i - 2)];
+		const int b = line[off(i + 2)];
+		const int lo = std::min(a, b);
+		const int hi = std::max(a, b);
+		const int v = *p;
+
+		if (v > hi + thr)
+			*p = static_cast<uint8_t>(hi);
+		else if (v < lo - thr)
+			*p = static_cast<uint8_t>(lo);
+	}
+}
