+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026
+ *
+ * Defective-pixel correction
+ *
+ * This algorithm only carries the enable/threshold tuning down to the CPU
+ * debayer via DebayerParams; the actual clamp on the raw Bayer data (before
+ * demosaic, against same-colour neighbours) is done in DebayerCpu.
+ */
+
+#include "dpc.h"
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftDpc)
+
+int Dpc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	auto threshold = tuningData["threshold"].get<uint32_t>();
+	if (threshold.has_value())
+		threshold_ = threshold.value();
+
+	LOG(IPASoftDpc, Debug) << "DPC threshold " << threshold_;
+	return 0;
+}
+
+void Dpc::prepare([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	params->dpcEnable = true;
+	params->dpcThreshold = threshold_;
+}
+
+REGISTER_IPA_ALGORITHM(Dpc, "Dpc")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
