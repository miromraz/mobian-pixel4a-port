#!/bin/sh
# Apply screen orientation matching the current Plasma mode:
#   plasma-mobile.desktop  -> portrait  (vertical, rotation none)
#   plasma.desktop / other -> landscape (rotation right)
# Installed as a Plasma autostart entry; runs on each login in both shells, so
# after plasma-mode-switch flips the SDDM autologin session and relaunches, the
# new session lands in the correct orientation. DSI-1 is the (only) panel; its
# native scan-out is portrait, so rotation.none = portrait and .right = landscape.
export LANG=C.UTF-8 LC_ALL=C.UTF-8
CONF=/etc/sddm.conf.d/zz-autologin.conf
OUT=DSI-1
mode=$(sed -n "s/^Session=//p" "$CONF" 2>/dev/null | head -n1)
case "$mode" in
  plasma-mobile.desktop) rot=none ;;
  *)                     rot=right ;;
esac
# kscreen/kwin may not be ready yet at autostart; wait for the panel to appear.
for i in $(seq 1 25); do
  kscreen-doctor -o 2>/dev/null | grep -q "$OUT" && break
  sleep 1
done
kscreen-doctor "output.$OUT.rotation.$rot" >/dev/null 2>&1
# Auto-rotation (2026-07-31). KWin rotates only when the output's autoRotation permits it and
# the default is InTabletMode; this device exposes no tablet-mode switch, so under
# plasma.desktop KWin never claims the accelerometer and the screen never follows tilt --
# even with sensors fully working. Prefer the live kscreen-doctor verb (Plasma 6.6+); older
# kscreen-doctor (trixie's 6.3.6) has no autorotate verb, so fall back to editing the config,
# which converges on the next login since KWin has already read it this session.
# Plain string swap on purpose: no JSON parsing, so this cannot corrupt the file.
if ! kscreen-doctor "output.$OUT.autorotate.always" >/dev/null 2>&1; then
  KOC="$HOME/.config/kwinoutputconfig.json"
  [ -f "$KOC" ] && sed -i \
    's/"autoRotation"[[:space:]]*:[[:space:]]*"[^"]*"/"autoRotation": "Always"/g' "$KOC"
fi
exit 0
