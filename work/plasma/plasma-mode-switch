#!/bin/sh
# Flip the SDDM autologin session between Plasma Mobile and Plasma Desktop,
# then restart SDDM. Runs as root (via pkexec).
set -eu

CONF=/etc/sddm.conf.d/zz-autologin.conf
SESS_DIR=/usr/share/wayland-sessions
MOBILE=plasma-mobile.desktop
DESKTOP=plasma.desktop

current=$(sed -n 's/^Session=//p' "$CONF" 2>/dev/null | head -n1)

case "$current" in
    "$MOBILE")  target=$DESKTOP ;;
    "$DESKTOP") target=$MOBILE ;;
    *)          target=$MOBILE ;;   # unknown/empty -> safe default
esac

if [ ! -f "$SESS_DIR/$target" ]; then
    echo "plasma-mode-switch: target session '$target' not found in $SESS_DIR; aborting (not restarting sddm)" \
        | systemd-cat -t plasma-mode-switch -p err
    exit 1
fi

mkdir -p "$(dirname "$CONF")"
cat > "$CONF" <<EOF
[Autologin]
User=mobian
Session=$target

[General]
DisplayServer=wayland
EOF

logger -t plasma-mode-switch "switching session $current -> $target; relaunching graphical stack"

# Plasma 6 runs kwin and plasmashell as systemd *user* services under
# user@<uid>.service (plasma-kwin_wayland.service, plasma-plasmashell.service).
# These live OUTSIDE sddm.service's cgroup and OUTSIDE the login session scope,
# so neither "systemctl restart sddm" nor "loginctl terminate-seat" stops them --
# the stale shell from the old mode leaks into the new session. To land cleanly we
# must end every session of the user AND the user systemd manager.
#
# That teardown also kills this very script's session (and any SSH session), so the
# SDDM relaunch is scheduled in a transient SYSTEM unit (run by root, outside any
# user session) that fires a few seconds later -- after the user manager is gone and
# DRM is released -- and autologins into $target.
systemctl stop sddm || true
systemd-run --collect /bin/sh -c \
    'for i in $(seq 1 30); do systemctl is-active -q user@1000.service || break; sleep 0.5; done; systemctl start sddm' \
    >/dev/null 2>&1 || true
loginctl terminate-user mobian 2>/dev/null || true

# If we are still alive here (e.g. invoked without a user session to tear down),
# make sure SDDM comes back ourselves once the user manager is gone.
for i in $(seq 1 30); do
    systemctl is-active -q user@1000.service || break
    sleep 0.5
done
systemctl start sddm 2>/dev/null || true
exit 0
